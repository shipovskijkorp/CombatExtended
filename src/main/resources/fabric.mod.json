{
  "schemaVersion": 1,
  "id": "combatextended",
  "version": "${version}",
  "name": "Combat Extended",
  "description": "Combat rebalance and anti-abuse layer for Minecraft 26.1.2.",
  "authors": [
    "ShipovskijKorp"
  ],
  "contact": {
    "sources": "https://github.com/shipovskijkorp/CombatExtended"
  },
  "license": "MIT",
  "icon": "assets/combatextended/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.shipovskijkorp.combatextended.CombatExtended"
    ]
  },
  "mixins": [
    "combatextended.mixins.json",
    {
      "config": "combatextended.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
