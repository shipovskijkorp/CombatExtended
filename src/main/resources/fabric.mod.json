{
  "schemaVersion": 1,
  "id": "combatextended",
  "version": "${version}",
  "name": "Combat Extended",
  "description": "Server-side combat rebalance and anti-abuse layer for Minecraft combat.",
  "authors": [
    "ShipovskijKorp"
  ],
  "contact": {
    "sources": "https://github.com/shipovskijkorp/CombatExtended"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/combatextended/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.shipovskijkorp.combatextended.CombatExtended"
    ],
    "client": [
      "com.shipovskijkorp.combatextended.client.CombatExtendedClient"
    ],
    "fabric-datagen": [
      "com.shipovskijkorp.combatextended.client.CombatExtendedDataGenerator"
    ]
  },
  "mixins": [
    "combatextended.mixins.json",
    {
      "config": "combatextended.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
